# Environment configuration for CareThread

FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# LLM mode: live | replay | mock
CT_LLM_MODE=mock
CT_LLM_BACKEND=opencode_serve
CT_LLM_CONFIG=config/llm.yaml
OPENCODE_BASE_URL=http://localhost:4096
OPENCODE_SERVER_PASSWORD=
OPENCODE_API_KEY=

CT_LLM_CONCURRENCY=3
CT_LLM_PRIVACY=standard
CT_LLM_CACHE_DIR=fixtures/llm_cache
CT_EMBED_MODEL=BAAI/bge-small-en-v1.5
CT_CLOCK=real
CT_STALE_THRESHOLD=0.3
CT_MIN_SCORE=0.2
CT_TOKENS_FILE=config/agents.yaml
CT_INTERNAL=1
